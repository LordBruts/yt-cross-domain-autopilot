# ---------------------------------------------------------------
# Media worker environment. Copy to .env and fill in.
#
# .env is gitignored. The ElevenLabs key belongs HERE and nowhere else --
# in particular NOT in the n8n Config node, whose values are written into
# workflow.json, which is committed.
# ---------------------------------------------------------------

# 'elevenlabs' (default) or 'edge' to force the free fallback voice.
# Set to 'edge' while developing so test renders cost no characters.
TTS_PROVIDER=elevenlabs

# Free tier is 10,000 characters/month; a 3-minute script is ~2,260, so
# about four videos before the quota is gone. Check with GET /tts/quota.
ELEVENLABS_API_KEY=

# A voice ID, not a name. List them with:
#   curl -H "xi-api-key: $ELEVENLABS_API_KEY" https://api.elevenlabs.io/v1/voices
# Default in app.py is JBFqnCBsd6RMkjVDRZzb ("George").
ELEVENLABS_VOICE_ID=

# eleven_multilingual_v2 = 1 credit/char. eleven_flash_v2_5 = 0.5, lower
# quality, and doubles how many videos fit in the free tier.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Advisory ceiling: a longer video is recorded as over_length and ships anyway.
MAX_VIDEO_SECONDS=180

# BLOCKING spend guard: refuses to synthesize at all above this, having spent
# nothing. Not a length limit -- set well above what the format should produce.
MAX_TTS_CHARS=3200

# Optional: route transcript fetches through a proxy.
TRANSCRIPT_PROXY=
