# ---------------------------------------------------------------
# Template only. Never put real values in this file.
#
# Secrets live in the n8n credential store, not here and not in the
# container environment. This file documents what scripts/create-credentials.js
# expects on the command line, e.g.:
#
#   PEXELS_API_KEY=... YOUTUBE_CLIENT_ID=... node scripts/create-credentials.js
#
# Non-secret config (channel IDs, domains, niche context, video length)
# lives in the workflow's "Config" node, editable in the n8n UI.
# ---------------------------------------------------------------

# Stock footage
PEXELS_API_KEY=

# Google / YouTube
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=

# n8n REST API (read from .mcp.json by default; override here if needed)
N8N_API_URL=http://localhost:5678
N8N_API_KEY=

# Media worker
MEDIA_WORKER_URL=http://host.docker.internal:8099
